{
  "name": "Bankers Gameplay",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "BankersGameplay": {
        "$path": "src/gameplay/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "BankersGameplay": {
        "$path": "src/gameplay/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": false,
        "BankersGameplay": {
          "$path": "src/gameplay/client"
        }
      }
    }
  }
}
